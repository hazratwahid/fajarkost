rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default safety catch-all: deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "hazrat.wahid@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Rooms Collection
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Tenants Collection
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Maintenance Tickets Collection
    match /tickets/{ticketId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() || isAdmin();
    }

    // Financial Records Collection
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Electricity Meter Logs Collection
    match /meterLogs/{meterLogId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Staff Members Collection
    match /staff/{staffId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Configuration Collection (OwnerProfile & KostProfile)
    match /config/{docId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Admin Role Lookup Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
